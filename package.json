{
  "name": "shengji-recorder",
  "version": "0.1.0",
  "private": true,
  "description": "声记：离线录屏、录音、逐字稿与 Word 导出",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "ShengJi contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "model:prepare": "node scripts/prepare-model.mjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win portable",
    "android:sync": "cap sync android",
    "prebuild": "node electron/prepare-notices.cjs",
    "test:desktop": "node electron/smoke.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2",
    "@huggingface/transformers": "3.8.1",
    "docx": "9.7.2",
    "idb": "8.0.3",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "typescript": "~5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
